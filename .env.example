# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Database ─────────────────────────────────────────────────────────────────
# Project settings → Database → Connection string → Transaction pooler.
# Used by the app at runtime.
DATABASE_URL=""
# Direct (session) connection, port 5432. Used by drizzle-kit for migrations,
# which the transaction pooler cannot run.
DIRECT_URL=""

# ── SMS (phone OTP) ──────────────────────────────────────────────────────────
# An Israeli gateway (InforU / 019) delivers with a local sender ID, which
# matters for OTP trust. Configured in the Supabase dashboard, not here.

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Analytics & errors ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
SENTRY_DSN=""

# ── Web Push ─────────────────────────────────────────────────────────────────
# No vendor and no account: VAPID keys are self-signed, which is why push is
# the one notification channel that is not blocked on a provider. Generate a
# pair with:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key reaches the browser; the private one signs the request to the
# push service and must not. Rotating them invalidates every existing
# subscription, so generate once per environment and keep them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Required by the spec: how a push service contacts you about your sending.
VAPID_SUBJECT="mailto:hello@darsak.co.il"
