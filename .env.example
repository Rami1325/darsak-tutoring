# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Database ─────────────────────────────────────────────────────────────────
# Project settings → Database → Connection string → Transaction pooler.
# Used by the app at runtime.
DATABASE_URL=""
# Direct (session) connection, port 5432. Used by drizzle-kit for migrations,
# which the transaction pooler cannot run.
DIRECT_URL=""

# ── Privacy ──────────────────────────────────────────────────────────────────
# Salts the visitor-IP hash recorded against phone reveals, so a database dump
# can't be reversed into a list of who looked at whom. Any long random string.
# Optional in development; set it in production.
IP_HASH_SALT=""

# ── SMS (phone OTP) ──────────────────────────────────────────────────────────
# An Israeli gateway (InforU / 019) delivers with a local sender ID, which
# matters for OTP trust. Configured in the Supabase dashboard, not here.

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Analytics & errors ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
SENTRY_DSN=""
